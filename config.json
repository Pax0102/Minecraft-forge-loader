{
    "ram": 4,
    "language": "pt-BR",

    "backupBeforeUpdate": true,
    "backupRetentionDays": 7,
    "backupExclude": ["logs", "crash-reports", "*.tmp"],
    "liveBackupIntervalMinutes": 0,

    "checkMinecraft": true,
    "checkForgeVersion": true,
    "checkJava": true,

    "autoInstallForge": true,
    "autoInstallJava": true,

    "verifyDownloads": true,

    "deleteTemporaryFiles": true,

    "coloredConsole": true,

    "downloadProgress": true,

    "logs": true,

    "autoRestart": false,
    "maxRestartAttempts": 3,

    "rconEnabled": false,
    "rconPort": 25575,
    "rconPassword": "",

    "discordWebhookUrl": ""
}
